# Database
DATABASE_URL=postgresql://user:password@localhost:5432/queer_kitchen_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development

# Branding / link previews
APP_NAME=Simple Invites
PUBLIC_APP_URL=https://app.erikasalomon.events
APP_TIMEZONE=America/Chicago
# Path to built SPA index.html, or URL to fetch it (Docker: http://frontend/index.html)
# SPA_INDEX_HTML=/spa/index.html
SPA_INDEX_URL=http://frontend/index.html
